# Colcon / ROS 2 build output
/build/
/install/
/log/
**/build/
**/install/
**/log/

# Per-experiment colcon trees (build_s1, install_s1, build_band, build_e85g, ...)
# These are experiment build products, not source; install_s1 holds the campaign's
# per-K mapper binaries and must never be rewritten by a checkout.
build_*/
install_*/
log_*/

# Python
**/__pycache__/
*.pyc
*.pyo
*.egg-info/

# Eval data / artifacts (regenerate from scripts)
**/results/
**/data/
**/*.npz
**/*.npz.*
**/*.ply
**/*.bag
**/*.bag.*
**/*.mcap

# Per-cell stdout logs from eval batches (reproducible from scripts)
**/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Paper sources (kept locally, not tracked)
scovox_paper/
